          "git stash": "allow",
          "git stash *": "allow",
          "git merge *": "allow",
          "git rebase *": "allow",
          "git restore *": "allow",
          "git cherry-pick *": "allow",
          "git revert *": "allow",
          "git clean -n*": "allow",
          "git fetch": "allow",
          "git fetch *": "allow",
          "git pull": "allow",
          "git pull *": "allow",
          "git branch *": "allow",
          "git tag *": "allow",
          "npm install*": "allow",
          "npm ci*": "allow",
          "npm run*": "allow",
          "npm test*": "allow",
          "npm exec*": "allow",
          "npm audit*": "allow",
          "npm prune*": "allow",
          "npx *": "allow",
          "yarn *": "allow",
          "pnpm *": "allow",
          "bun *": "allow",
          "bunx *": "allow",
          "node *": "allow",
          "deno *": "allow",
          "pip install*": "allow",
          "pip uninstall*": "allow",
          "python *": "allow",
          "python3 *": "allow",
          "pytest*": "allow",
          "poetry *": "allow",
          "uv *": "allow",
          "ruff *": "allow",
          "black *": "allow",
          "mypy *": "allow",
